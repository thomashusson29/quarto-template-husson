{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lancer Quarto Husson Studio (Port 8502)",
            "type": "shell",
            "command": "/opt/anaconda3/bin/streamlit run /Users/thomashusson/Documents/Projets/quarto-template-husson/gui/app.py --server.port 8502 --server.address 0.0.0.0 --server.enableCORS false --server.enableXsrfProtection false",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Local URL:.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
