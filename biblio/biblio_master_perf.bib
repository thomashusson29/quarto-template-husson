@article{dehaanNormothermicHumanKidney2025,
  title = {Normothermic Human Kidney Preservation Drives Iron Accumulation and Ferroptosis},
  author = {{de Haan}, Marlon J. A. and Jacobs, Marleen E. and {de Graaf}, Annemarie M. A. and {van Scheppingen}, Roan H. and Derks, Rico J. E. and {de Vries}, Dorottya K. and Kers, Jesper and Alwayn, Ian P. J. and {van Kooten}, Cees and {S{\'a}nchez-L{\'o}pez}, Elena and Giera, Martin and Engelse, Marten A. and Rabelink, Ton J.},
  year = 2025,
  month = jul,
  journal = {Nature Communications},
  volume = {16},
  number = {1},
  pages = {5420},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-61058-9},
  urldate = {2025-11-06},
  abstract = {Ex vivo normothermic machine perfusion has been proposed to protect deceased donor kidneys. However, its benefits remain ambiguous. We postulate that the use of red blood cells (RBCs) and associated secondary hemolysis may in fact cause renal injury, offsetting potential advantages. During 48-hour normothermic perfusion of seven human donor kidneys, we observed progressive hemolysis, leading to iron accumulation in perfusate and~tissue. Untargeted lipidomic profiling revealed significant increases in oxidized phospholipid species in perfused kidneys, pointing towards iron-dependent cell death known as ferroptosis. Next, in twelve additional perfusions, we assessed strategies to mitigate hemolysis-driven injury. Dialysis-based free hemoglobin removal reduced lipid peroxidation, but a ferroptosis gene signature persisted. In contrast, cell-free perfusion at subnormothermia negated iron accumulation, the ferroptosis gene signature, phospholipid peroxidation, and acute kidney injury. Our findings highlight the pathological role of hemolysis and iron on the kidney, urging restraint in the clinical application of RBC-based kidney perfusion.},
  copyright = {2025 The Author(s)},
  langid = {english},
  keywords = {Kidney,Lipidomics,Mass_spectrometry,Regenerative_medicine},
  file = {/Users/thomashusson/Zotero/storage/JEL4V2ZY/de Haan et al. - 2025 - Normothermic human kidney preservation drives iron accumulation and ferroptosis.pdf}
}

@article{devriesPretransplantSequentialHypo2019,
  title = {Pretransplant Sequential Hypo- and Normothermic Machine Perfusion of Suboptimal Livers Donated after Circulatory Death Using a Hemoglobin-based Oxygen Carrier Perfusion Solution},
  author = {{de Vries}, Yvonne and Matton, Alix P. M. and Nijsten, Maarten W. N. and Werner, Maureen J. M. and {van den Berg}, Aad P. and {de Boer}, Marieke T. and Buis, Carlijn I. and Fujiyoshi, Masato and {de Kleine}, Ruben H. J. and {van Leeuwen}, Otto B. and Meyer, Peter and {van den Heuvel}, Marius C. and {de Meijer}, Vincent E. and Porte, Robert J.},
  year = 2019,
  month = apr,
  journal = {American Journal of Transplantation},
  volume = {19},
  number = {4},
  pages = {1202--1211},
  issn = {1600-6135},
  doi = {10.1111/ajt.15228},
  urldate = {2025-11-10},
  abstract = {Ex situ dual hypothermic oxygenated machine perfusion (DHOPE) and normothermic machine perfusion (NMP) of donor livers may have a complementary effect when applied sequentially. While DHOPE resuscitates the mitochondria and increases hepatic adenosine triphosphate (ATP) content, NMP enables hepatobiliary viability assessment prior to transplantation. In contrast to DHOPE, NMP requires a perfusion solution with an oxygen carrier, for which red blood cells (RBC) have been used in most series. RBC, however, have limitations and cannot be used cold. We, therefore, established a protocol of sequential DHOPE, controlled oxygenated rewarming (COR), and NMP using a new hemoglobin-based oxygen carrier (HBOC)-based perfusion fluid (DHOPE-COR-NMP trial, NTR5972). Seven livers from donation after circulatory death (DCD) donors, which were initially declined for transplantation nationwide, underwent DHOPE-COR-NMP. Livers were considered transplantable if perfusate pH and lactate normalized, bile production was {$\geq$}10~mL and biliary pH~{$>~$}7.45 within 150~minutes of NMP. Based on these criteria five livers were transplanted. The primary endpoint, 3-month graft survival, was a 100\%. In conclusion, sequential DHOPE-COR-NMP using an HBOC-based perfusion fluid offers a novel method of liver machine perfusion for combined resuscitation and viability testing of suboptimal livers prior to transplantation., This clinical cohort study indicates that a combination of hypo- and normothermic machine perfusion, using a preservation fluid containing an hemoglobin-based oxygen carrier, is feasible and provides a tool to resuscitate and select initially declined high-risk donor livers that can be transplanted successfully.},
  pmcid = {PMC6590255},
  pmid = {30588774},
  file = {/Users/thomashusson/Zotero/storage/MSJQCS3D/de Vries et al. - 2019 - Pretransplant sequential hypo‐ and normothermic machine perfusion of suboptimal livers donated after.pdf}
}

