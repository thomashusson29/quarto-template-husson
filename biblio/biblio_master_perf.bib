  author = {Clarke, George and Mao, Jingwen and Hann, Angus and Fan, Yiyu and Gupta, Amita and Nutu, Anisa and Buckel Schaffner, Erwin and Kayani, Kayani and Murphy, Nicholas and Bangash, Mansoor N. and Casey, Anna L. and Wootton, Isla and Lawson, Alexander J. and Dasari, Bobby V. M. and Perera, M. Thamara P. R. and Mergental, Hynek and Afford, Simon C.},
  year = 2024,
