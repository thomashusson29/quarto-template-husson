  keywords = {*Liver Transplantation/methods/standards,/unread,donor,End Stage Liver Disease/surgery,Humans,immunosuppression,liver transplantation,recipient,recurrence,transplant oncology}
}

@article{feizpourSimultaneousExVivo2022,
  title = {Simultaneous Ex Vivo Normothermic Preservation of Liver and Heart Grafts from a Donation after Circulatory Death Donor},
  author = {Feizpour, Cyrus A. and Hoffman, Jordan and Patel, Madhukar S. and Wang, Benjamin and Hwang, Christine and Balsara, Keki and Shah, Ashish and Shah, Jigesh A. and Hanish, Steven I. and Vagefi, Parsia A. and MacConmara, Malcolm},
