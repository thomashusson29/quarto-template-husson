\par
P value {$\simeq$} 0.889},
  file = {/Users/thomashusson/Zotero/storage/JRC5QW4A/Laing et al. - 2017 - The Use of an Acellular Oxygen Carrier in a Human Liver Model of Normothermic Machine Perfusion.pdf;/Users/thomashusson/Zotero/storage/XRK25JNM/NIHMS72766-supplement-Supplemental_Digital_Content_to_Be_Published__cited_in_text_.docx}
