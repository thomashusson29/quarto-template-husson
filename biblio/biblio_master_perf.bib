  pages = {2--14},
  issn = {2671-8790},
  doi = {10.4285/kjt.22.0008},
  urldate = {2025-11-10},
  abstract = {Transplantation is the method of choice and, in many cases, the only method of treatment for patients with end-stage organ disease. Excellent results have been achieved, and the main focus today is to extend the number of available donors. The use of extended-criteria donors or donors after circulatory death is standard, but is accompanied by an increased risk of ischemia reperfusion injury. This review presents newly developed machine perfusion techniques using hypothermic, subnormothermic, or normothermic conditions, with or without oxygenation. Possibilities for treatment and quality assessment in decision-making about organ acceptability are also discussed.},
