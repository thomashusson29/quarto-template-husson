@article{lauLongtermExSitu2023,
  title = {Long-Term Ex Situ Normothermic Perfusion of Human Split Livers for More than 1 Week},
  author = {Lau, Ngee-Soon and Ly, Mark and Dennis, Claude and Jacques, Andrew and {Cabanes-Creus}, Marti and Toomath, Shamus and Huang, Joanna and Mestrovic, Nicole and Yousif, Paul and Chanda, Sumon and Wang, Chuanmin and Lisowski, Leszek and Liu, Ken and Kench, James G. and McCaughan, Geoffrey and Crawford, Michael and Pulitano, Carlo},
  year = 2023,
  month = aug,
  journal = {Nature Communications},
  volume = {14},
  number = {1},
  pages = {4755},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-023-40154-8},
  urldate = {2026-07-29},
  abstract = {Current machine perfusion technology permits livers to be preserved ex situ for short periods to assess viability prior to transplant. Long-term normothermic perfusion of livers is an emerging field with tremendous potential for the assessment, recovery, and modification of organs. In this study, we aimed to develop a long-term model of ex situ perfusion including a surgical split and simultaneous perfusion of both partial organs. Human livers declined for transplantation were perfused using a red blood cell-based perfusate under normothermic conditions (36\,{$^\circ$}C) and then split and simultaneously perfused on separate machines. Ten human livers were split, resulting in 20 partial livers. The median ex situ viability was 125\,h, and the median ex situ survival was 165\,h. Long-term survival was demonstrated by lactate clearance, bile production, Factor-V production, and storage of adenosine triphosphate. Here, we report the long-term ex situ perfusion of human livers and demonstrate the ability to split and perfuse these organs using a standardised protocol.},
  copyright = {2023 The Author(s)},
  langid = {english},
  keywords = {Liver,Translational_research},
  file = {/Users/thomashusson/Zotero/storage/Q6QD9ZN4/Lau et al. - 2023 - Long-term ex situ normothermic perfusion of human split livers for more than 1 week.pdf}
}

